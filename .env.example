# docker-compose settings. Copy to .env (git-ignored); never commit real values.

# Required: signs login tokens. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional: Google Gemini key for the Explain stage (templates are used without it)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Database (defaults shown)
# POSTGRES_DB=resq_nexus
# POSTGRES_USER=resq
# POSTGRES_PASSWORD=resq
# POSTGRES_PORT=5432

# Ports on your machine
# FRONTEND_PORT=8080
# BACKEND_PORT=8000

# Load the SYNTHETIC demo accounts, resources and SOS requests into an empty database
# SEED_DEMO_DATA=1
