# ResQ Nexus Backend Environment Configuration
# Copy this file to backend/.env (git-ignored); never commit real secrets or credentials.

# -----------------------------------------------------------------------------
# Security & Authentication (Required for Production)
# -----------------------------------------------------------------------------
# Secret used to sign JWT authentication tokens (generate via python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=dummy-jwt-secret-replace-in-production-random-48-chars

# Token lifetime in minutes (default: 720 = 12 hours)
JWT_EXPIRE_MINUTES=720

# Shared secret key protecting the POST /jobs/poll cron endpoint from unauthorised execution
CRON_SECRET=dummy-cron-secret-replace-with-random-hex-token

# -----------------------------------------------------------------------------
# Google Gemini API (Situation Reports & Decision Explanations)
# -----------------------------------------------------------------------------
# Google AI Studio API key (https://aistudio.google.com/apikey). Optional: deterministic templates are used if omitted.
GEMINI_API_KEY=

# Model identifier (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL + PostGIS / SQLite)
# -----------------------------------------------------------------------------
# Production PostgreSQL + PostGIS URL (e.g. Supabase session pooler connection string):
# DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres
# Local development default without DATABASE_URL is SQLite at backend/instance/resq_nexus.db

# Automatically load the synthetic demo accounts, resources, and initial SOS requests on an empty database (1 or 0)
SEED_DEMO_DATA=1

# -----------------------------------------------------------------------------
# Network, CORS & Deployment
# -----------------------------------------------------------------------------
# Production frontend URL allowed to call the API (e.g. Vercel deployment URL)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated allowed origins (fallback)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server listening port (Render sets $PORT automatically, default: 8000)
PORT=8000

# Airgapped/offline test mode: when set to 1, external network calls to STAC / GDACS / USGS are bypassed using recorded test fixtures
OFFLINE_MODE=0
