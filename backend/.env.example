# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored: never commit a real key.

# Google Gemini API key (https://aistudio.google.com/apikey).
# Only needed for the Explain stage; the dashboard and priority scoring run without it.
GEMINI_API_KEY=

# Optional: Gemini model name (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Optional: comma-separated origins allowed to call the API (default: the Vite dev server)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret that signs login tokens (JWTs). Required outside local development; use at least
# 32 random characters, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the API makes a temporary secret, so every login ends when the server restarts.
JWT_SECRET=

# Optional: how long a login lasts, in minutes (default: 720 = 12 hours)
# JWT_EXPIRE_MINUTES=720

# Optional: database. docker-compose sets PostgreSQL + PostGIS (locations are PostGIS geometry,
# schema via `alembic upgrade head`). Default without it: a SQLite file at backend/instance/resq_nexus.db.
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resq_nexus

# Optional: load the demo accounts, resources and SOS requests into an empty database (default: 1)
# SEED_DEMO_DATA=1
